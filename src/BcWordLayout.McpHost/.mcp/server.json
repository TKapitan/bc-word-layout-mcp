{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.tkapitan/bc-word-layout-mcp",
  "description": "Create, edit, validate and preview Word report layouts for Microsoft Dynamics 365 Business Central.",
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "nuget",
      "registryBaseUrl": "https://api.nuget.org",
      "identifier": "BcWordLayout.Mcp",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [],
      "environmentVariables": [
        {
          "name": "BCWL_LABEL_SUFFIXES",
          "value": "{bcwl_label_suffixes}",
          "variables": {
            "bcwl_label_suffixes": {
              "description": "Optional. Comma-separated dataset label-name suffixes (default: Lbl); empty = the BC default.",
              "isRequired": false,
              "isSecret": false
            }
          }
        },
        {
          "name": "BCWL_LABELS_DATA_ITEM",
          "value": "{bcwl_labels_data_item}",
          "variables": {
            "bcwl_labels_data_item": {
              "description": "Optional. Data item whose direct columns are all labels (default: Labels); '-' disables the rule.",
              "isRequired": false,
              "isSecret": false
            }
          }
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/TKapitan/bc-word-layout-mcp",
    "source": "github"
  }
}
