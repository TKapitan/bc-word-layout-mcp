<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The discipline is mechanized, not exemplary (release plan G5/B6): every warning fails the
         build, with the built-in .NET analyzers at the recommended tier. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- Bump Version + InformationalVersion for every release, RCs included (docs/RELEASING.md §1);
       AssemblyVersion/FileVersion stay numeric because they cannot carry a -rc.N suffix. The tag
       must match <Version> exactly — release.yml refuses to publish otherwise. -->
  <PropertyGroup>
    <Version>1.1.0-rc.1</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0-rc.1</InformationalVersion>
  </PropertyGroup>
</Project>
